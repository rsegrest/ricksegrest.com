{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/globe", "destination": "/demos/travel-globe/index.html" },
    { "source": "/globe/", "destination": "/demos/travel-globe/index.html" },
    { "source": "/demos/(.*)", "destination": "/demos/$1" },
    { "source": "/:path((?!demos/).*)", "destination": "/index.html" }
  ]
}
